<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="393.0" prefWidth="487.0" spacing="20.0" styleClass="panel-default" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.repaso.SecondaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="label-title" text="Datos del Usuario" />
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
            <children>
                <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="15.0">
                    <children>
                        <Label styleClass="label-info" text="Nombre" />
                        <Label styleClass="label-info" text="Apellido" />
                        <Label styleClass="label-info" text="Edad" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0" spacing="5.0">
                    <children>
                        <TextField fx:id="txtNombre" />
                        <TextField fx:id="txtApellido" />
                        <TextField fx:id="txtEdad" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="150.0" spacing="10.0">
                    <children>
                        <RadioButton fx:id="rbAdmin" mnemonicParsing="false" text="Administrador">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgRol" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbEditor" mnemonicParsing="false" text="Editor" toggleGroup="$tgRol" />
                        <RadioButton fx:id="rbLector" mnemonicParsing="false" text="Lector" toggleGroup="$tgRol" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="15.0">
            <children>
                <Label styleClass="label-info" text="Ciudad" />
                <ChoiceBox fx:id="cbCiudad" prefWidth="150.0" />
            </children>
        </HBox>
        <Button styleClass="button-primary" mnemonicParsing="false" onAction="#verDatos" text="Ver datos en ventana nueva" />
    </children>
</VBox>
