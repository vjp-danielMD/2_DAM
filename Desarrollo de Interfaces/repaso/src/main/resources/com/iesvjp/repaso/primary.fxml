<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" styleClass="panel-default" stylesheets="@styles.css" prefHeight="493.0" prefWidth="618.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.repaso.PrimaryController">
   <children>
      <Label styleClass="label-title" text="COCHES" />
      <TableView fx:id="tablaCoches" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colModelo" prefWidth="112.0" text="MODELO" />
          <TableColumn fx:id="colMarca" prefWidth="114.0" text="MARCA" />
            <TableColumn fx:id="colColor" prefWidth="112.0" text="COLOR" />
            <TableColumn fx:id="colFoto" prefWidth="239.0" text="FOTO" />
        </columns>
      </TableView>
      <HBox alignment="CENTER" prefHeight="46.0" prefWidth="578.0">
         <children>
            <Button fx:id="buttonAnadir" styleClass="button-success" mnemonicParsing="false" text="AÑADIR" onAction="#cargarCoche" />
            <Button fx:id="buttonBorrar" styleClass="button-danger" mnemonicParsing="false" text="BORRAR" onAction="#eliminarCoche" />
            <Button fx:id="buttonModificar" styleClass="button-primary" mnemonicParsing="false" text="MODIFICAR" onAction="#modificarCoche" />
            <Button fx:id="buttonVerFoto" styleClass="button-outline" mnemonicParsing="false" text="VER FOTO" onAction="#verFoto"/>
            <Button fx:id="primaryButton" styleClass="button-primary" onAction="#ejercicioDos" text="EJERCICIO 2" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
