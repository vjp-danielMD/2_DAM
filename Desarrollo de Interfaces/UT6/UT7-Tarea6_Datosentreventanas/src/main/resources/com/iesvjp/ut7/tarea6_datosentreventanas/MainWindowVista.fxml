<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.ut7.tarea6_datosentreventanas.controlador.MainWindowControlador">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <TableView fx:id="tblPersonas" prefHeight="320.0" prefWidth="590.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colApellidos" prefWidth="250.0" text="Apellidos" />
                        <TableColumn fx:id="colEdad" prefWidth="120.0" text="Edad" />
                    </columns>

                </TableView>
            
                <HBox alignment="CENTER" spacing="30.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#agregarPersona" prefHeight="30.0" prefWidth="140.0" text="Agregar persona" />
                        <Button mnemonicParsing="false" onAction="#modificarPersona" prefHeight="30.0" prefWidth="140.0" text="Modificar persona" />
                        <Button mnemonicParsing="false" onAction="#borrarPersona" prefHeight="30.0" prefWidth="140.0" text="Eliminar persona" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>