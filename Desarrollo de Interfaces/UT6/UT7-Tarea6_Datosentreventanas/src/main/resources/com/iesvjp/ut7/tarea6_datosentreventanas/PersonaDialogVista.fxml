<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="380.0" prefWidth="280.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.ut7.tarea6_datosentreventanas.controlador.PersonaDialogControlador">
    <children>
        <VBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Nombre" />
                <TextField fx:id="txtNombre" prefHeight="30.0" />
            
                <Label text="Apellidos">
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="txtApellidos" prefHeight="30.0" />
            
                <Label text="Edad">
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="txtEdad" prefHeight="30.0" />
            
                <VBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" prefHeight="30.0" prefWidth="200.0" text="Guardar" />
                        <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salir" prefHeight="30.0" prefWidth="200.0" text="Salir" />
                    </children>
                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>