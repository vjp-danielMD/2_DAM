<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.ut7t7.controlador.MainWindowController">
    <children>
        <HBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <TableView fx:id="tablaRegistros" prefHeight="250.0" prefWidth="280.0">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="139.0" text="Nombre" />
                                <TableColumn fx:id="colFoto" prefWidth="140.0" text="Foto" />
                            </columns>
                        </TableView>
                        <Button mnemonicParsing="false" onAction="#verFoto" prefHeight="35.0" prefWidth="280.0" styleClass="btn-ver-foto" text="Ver Foto en una ventana nueva" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" prefHeight="250.0" prefWidth="220.0" spacing="15.0">
                    <children>
                        <Label text="Nombre" />
                        <TextField fx:id="txtNombre" />
                        <Label text="Foto">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="txtFoto" />
                        <Button mnemonicParsing="false" onAction="#aniadirRegistro" prefHeight="35.0" prefWidth="100.0" styleClass="btn-aniadir" text="Añadir">
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>