<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="@dimen/padding_standard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_plaza"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/color_text"
            android:layout_marginBottom="@dimen/margin_small"/>

        <ImageView
            android:id="@+id/ivPlaza"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_height_monumento"
            android:scaleType="centerCrop"
            android:layout_marginBottom="@dimen/margin_large"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_plaza"/>

        <TextView
            android:id="@+id/tvCatedral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_catedral"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/color_text"
            android:layout_marginBottom="@dimen/margin_small"/>

        <ImageView
            android:id="@+id/ivCatedral"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_height_monumento"
            android:scaleType="centerCrop"
            android:layout_marginBottom="@dimen/margin_large"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_catedral"/>

        <TextView
            android:id="@+id/tvUniversidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_universidad"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="@color/color_text"
            android:layout_marginBottom="@dimen/margin_small"/>

        <ImageView
            android:id="@+id/ivUniversidad"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_height_monumento"
            android:scaleType="centerCrop"
            android:layout_marginBottom="@dimen/padding_standard"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_universidad"/>

    </LinearLayout>
</ScrollView>