<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_ivory">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modificar_obra_de_arte"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="@color/text_charcoal"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/id_de_la_obra_a_modificar"
                app:boxStrokeColor="@color/primary_walnut"
                app:hintTextColor="@color/primary_walnut">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdateIdBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscarUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buscar"
                android:layout_marginStart="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="@color/accent_gold"
                android:textColor="@color/primary_dark" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFormularioUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/nombre_de_la_obra"
                app:boxStrokeColor="@color/primary_walnut"
                app:hintTextColor="@color/primary_walnut">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdateNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/text_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/precio"
                app:boxStrokeColor="@color/primary_walnut"
                app:hintTextColor="@color/primary_walnut">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdatePrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/unidades"
                app:boxStrokeColor="@color/primary_walnut"
                app:hintTextColor="@color/primary_walnut">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdateUnidades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_charcoal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guardar_cambios"
                android:padding="12dp"
                app:backgroundTint="@color/primary_walnut"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>