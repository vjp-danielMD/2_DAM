<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_ivory">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registrar_obra_de_arte"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="@color/text_charcoal"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/nombre_de_la_obra_antig_edad"
            app:boxStrokeColor="@color/primary_walnut"
            app:hintTextColor="@color/primary_walnut">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/text_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/precio"
            app:boxStrokeColor="@color/primary_walnut"
            app:hintTextColor="@color/primary_walnut">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecioArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/text_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/unidades_en_stock"
            app:boxStrokeColor="@color/primary_walnut"
            app:hintTextColor="@color/primary_walnut">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUnidadesArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text_charcoal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarArticulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/a_adir_a_la_colecci_n"
            android:padding="12dp"
            app:backgroundTint="@color/primary_walnut"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>