<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="32dp"
    android:paddingTop="12dp"
    android:background="@color/background_ivory">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D1CFC9"
        android:backgroundTint="#D1CFC9"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvTituloSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/acciones_de_la_obra"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/text_charcoal"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetCompartir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/compartir"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="@color/primary_walnut"
        android:textColor="@color/white"
        app:iconPadding="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/modificar_detalles"
        android:padding="12dp"
        app:strokeColor="@color/accent_gold"
        app:strokeWidth="2dp"
        android:textColor="@color/primary_dark" />
</LinearLayout>