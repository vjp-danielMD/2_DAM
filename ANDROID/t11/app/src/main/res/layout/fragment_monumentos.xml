<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_plaza"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/ivPlaza"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="24dp"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_plaza"/>

        <TextView
            android:id="@+id/tvCatedral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_catedral"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/ivCatedral"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="24dp"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_catedral"/>

        <TextView
            android:id="@+id/tvUniversidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monumento_universidad"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/ivUniversidad"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            android:background="@color/gray"
            android:contentDescription="@string/monumento_universidad"/>

    </LinearLayout>
</ScrollView>