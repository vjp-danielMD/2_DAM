<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="402.0" prefWidth="650.0" spacing="20.0" styleClass="panel-default" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.exut7.danielmorenodominguez.PrimaryController">
   <children>
      <Label styleClass="label-title" text="Coches" />
      <TableView fx:id="tablaCoches" prefHeight="200.0" prefWidth="500.0">
        <columns>
          <TableColumn fx:id="colMarca" prefWidth="100.0" text="Marca" />
          <TableColumn fx:id="colModelo" prefWidth="100.0" text="Modelo" />
          <TableColumn fx:id="colColor" prefWidth="80.0" text="Color" />
          <TableColumn fx:id="colFoto" prefWidth="250.0" text="Foto" />
        </columns>
      </TableView>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
         <children>
            <Button styleClass="button-primary" mnemonicParsing="false" onAction="#agregarCoche" text="Añadir" />
            <Button styleClass="button-danger" mnemonicParsing="false" onAction="#eliminarCoche" text="Eliminar" />
            <Button styleClass="button-success" mnemonicParsing="false" onAction="#verFoto" text="Ver Foto" />
            <Button styleClass="button-primary" mnemonicParsing="false" onAction="#modificarCoche" text="Modificar" />
            <Button styleClass="button-outline" mnemonicParsing="false" onAction="#ejercicio2" text="EJERCICIO 2" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
