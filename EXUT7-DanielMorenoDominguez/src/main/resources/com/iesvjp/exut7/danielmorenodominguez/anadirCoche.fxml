<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" styleClass="panel-default" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesvjp.exut7.danielmorenodominguez.DialogCocheControlador">
    <children>
        <Label styleClass="label-subtitle" text="Datos del Coche" />
        <VBox spacing="5.0">
            <Label styleClass="label-info" text="Marca:" />
            <TextField fx:id="marca" />
        </VBox>
        <VBox spacing="5.0">
            <Label styleClass="label-info" text="Modelo:" />
            <TextField fx:id="modelo" />
        </VBox>
        <VBox spacing="5.0">
            <Label styleClass="label-info" text="Color:" />
            <TextField fx:id="color" />
        </VBox>
        <VBox spacing="5.0">
            <Label styleClass="label-info" text="Foto (URL):" />
            <TextField fx:id="foto" />
        </VBox>
        <Button styleClass="button-primary" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
